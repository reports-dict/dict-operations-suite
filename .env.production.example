APP_NAME="DICT Operations Suite"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# dict_operations_suite's own app DB - production host, not the local
# mysql8-mysql-1 dev container.
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=dict_operations_suite
DB_USERNAME=
DB_PASSWORD=

# Read-only Navis SPARCS N4 SQL Server connection (config/database.php: sparcsn4)
DB_SQLSRV_HOST=
DB_SQLSRV_PORT=1433
DB_SQLSRV_DATABASE=sparcsn4
DB_SQLSRV_USERNAME=
DB_SQLSRV_PASSWORD=

# LDAP / Active Directory - config/ldap.php
LDAP_LOGGING=true
LDAP_CONNECTION=default
LDAP_CONNECTIONS=default
LDAP_DEFAULT_HOSTS=
LDAP_DEFAULT_USERNAME=
LDAP_DEFAULT_PASSWORD=
LDAP_DEFAULT_PORT=389
LDAP_DEFAULT_BASE_DN=
LDAP_DEFAULT_TIMEOUT=5
LDAP_DEFAULT_SSL=false
LDAP_DEFAULT_TLS=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# BigQuery - Driver Assignment module (see config/bigquery.php). Service
# account JSON key goes at storage/app/private/bigquery-service-account.json,
# never committed.
BIGQUERY_PROJECT_ID=
BIGQUERY_CREDENTIALS_PATH=

VITE_APP_NAME="${APP_NAME}"

# Vessel Dashboard module's live database (config/database.php: vessel_dashboard)
# - shared with the standalone vessel-dashboard-app's own production MySQL,
# never run migrations against this connection.
VESSEL_DB_HOST=
VESSEL_DB_PORT=3306
VESSEL_DB_DATABASE=vessel_dashboard
VESSEL_DB_USERNAME=
VESSEL_DB_PASSWORD=
