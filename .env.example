APP_NAME="DICT Operations Suite"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dict_operations_suite
DB_USERNAME=root
DB_PASSWORD=

# Read-only Navis SPARCS N4 SQL Server connection (config/database.php: sparcsn4)
DB_SQLSRV_HOST=
DB_SQLSRV_PORT=1433
DB_SQLSRV_DATABASE=sparcsn4
DB_SQLSRV_USERNAME=
DB_SQLSRV_PASSWORD=

# LDAP / Active Directory - config/ldap.php
LDAP_LOGGING=true
LDAP_CONNECTION=default
LDAP_CONNECTIONS=default
LDAP_DEFAULT_HOSTS=
LDAP_DEFAULT_USERNAME=
LDAP_DEFAULT_PASSWORD=
LDAP_DEFAULT_PORT=389
LDAP_DEFAULT_BASE_DN=
LDAP_DEFAULT_TIMEOUT=5
LDAP_DEFAULT_SSL=false
LDAP_DEFAULT_TLS=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# BigQuery - Driver Assignment module (see config/bigquery.php). Service
# account JSON key goes at storage/app/private/bigquery-service-account.json,
# never committed.
BIGQUERY_PROJECT_ID=
BIGQUERY_CREDENTIALS_PATH=

VITE_APP_NAME="${APP_NAME}"

# Vessel Dashboard module's live database (config/database.php: vessel_dashboard)
# - shared with the standalone vessel-dashboard-app, never run migrations
# against this connection.
VESSEL_DB_HOST=
VESSEL_DB_PORT=3306
VESSEL_DB_DATABASE=vessel_dashboard
VESSEL_DB_USERNAME=
VESSEL_DB_PASSWORD=
